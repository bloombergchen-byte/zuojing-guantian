{
 "manifest_version": 3,
 "name": "坐井观天",
 "version": "1.0.0",
 "description": "本机保存的七分类纸页新标签主页。",
 "chrome_url_overrides": {"newtab":"index.html"},
 "background": {"service_worker":"worker.js"},
 "permissions": ["storage"],
 "optional_permissions": ["bookmarks"],
 "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
 "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'none'; base-uri 'self'; connect-src 'none'"}
}
