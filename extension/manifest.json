{
 "manifest_version": 3,
 "name": "坐井观天",
 "version": "1.1.1",
 "description": "七分类纸页新标签主页，支持可选Chrome同步和GitHub私有备份。",
 "chrome_url_overrides": {"newtab":"index.html"},
 "background": {"service_worker":"worker.js"},
 "permissions": ["storage","alarms"],
 "optional_permissions": ["bookmarks"],
 "optional_host_permissions": ["https://api.github.com/*"],
 "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
 "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'none'; base-uri 'self'; connect-src https://api.github.com"}
}
